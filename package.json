{
  "name": "holyberg-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:backgrounds": "node scripts/generate-berlin-background-assets.mjs",
    "generate:mobile-assets": "node scripts/generate-mobile-game-assets.mjs",
    "generate:rhythm-fixture": "node scripts/generate-rhythm-development-track.mjs",
    "verify:backgrounds": "node scripts/verify-berlin-background-assets.mjs",
    "predev": "npm run generate:backgrounds && npm run generate:mobile-assets && npm run generate:rhythm-fixture",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "npm run generate:backgrounds && npm run generate:mobile-assets && npm run generate:rhythm-fixture",
    "build": "tsc -b && vite build",
    "postbuild": "npm run verify:backgrounds && npm run verify:mobile-assets",
    "verify:mobile-assets": "node scripts/verify-mobile-game-assets.mjs",
    "worker:migrate": "wrangler d1 migrations apply holyberg-leaderboard --remote",
    "worker:deploy": "wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "generate:level4-toilet": "node scripts/generate-level4-toilet-asset.mjs"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "prettier": "^3.6.2",
    "sharp": "0.35.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
